# AURA backend environment variables
# Copy this file to .env and fill in real values locally.
# API keys are secrets — never commit .env or real keys to git.

# LLM provider: "openai" | "anthropic" | "groq"
LLM_PROVIDER=openai

# Provider API keys (set only the one matching LLM_PROVIDER)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Model id for the selected provider (e.g. gpt-4o-mini)
MODEL_NAME=

# Optional public web search for product research, trends, and comparisons.
# WEB_SEARCH_PROVIDER accepts: auto | tavily | serpapi
# In auto mode, Tavily is preferred when configured; SerpAPI is used otherwise.
TAVILY_API_KEY=
SERPAPI_KEY=
# Also used by Amazon product searches in the chat interface.
WEB_SEARCH_PROVIDER=auto
