# AURA backend environment variables
# Copy this file to .env and fill in real values locally.
# API keys are secrets — never commit .env or real keys to git.

# LLM provider: "openai" | "anthropic" | "groq"
LLM_PROVIDER=openai

# Provider API keys (set only the one matching LLM_PROVIDER)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Model id for the selected provider (e.g. gpt-4o-mini)
MODEL_NAME=
